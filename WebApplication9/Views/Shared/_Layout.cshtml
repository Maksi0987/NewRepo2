<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication9</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication9.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">NeuroHub</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="AiPrompts" asp-action="Index">Промпти</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @{
        var banner = Environment.GetEnvironmentVariable("UI_SystemBanner") ?? "Локальна розробка";
        var version = Environment.GetEnvironmentVariable("App_BuildVersion") ?? "v0.0-dev";
        var apiKey = Environment.GetEnvironmentVariable("Neuro_ApiKey");
        bool isAiModuleConnected = !string.IsNullOrEmpty(apiKey);
    }

    <div class="container text-center mt-3 mb-3 p-3 border rounded bg-light shadow-sm">
        <h4 class="text-primary">@banner</h4>
        <p class="text-muted mb-2">Версія збірки: <strong>@version</strong></p>

        @if (isAiModuleConnected)
        {
            <span class="badge bg-success fs-6 p-2">ШІ-Модуль підключено</span>
        }
        else
        {
            <span class="badge bg-danger fs-6 p-2">ШІ-Модуль деактивовано</span>
        }
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - NeuroHub
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>